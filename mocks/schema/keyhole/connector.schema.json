{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vbcdx.dev/keyhole/connector.schema.json",
  "title": "Vault connector or sidecar",
  "description": "keyhole.connectors — installed keyholed processes. kind vault: reaches customer vaults behind the firewall (stores route through it). kind sidecar: runs next to an app, bound to one agent in one workspace; the app calls it locally and never holds the secret. Presence and heartbeats live in Redis; this row is written on transitions.",
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "oneOf": [
        {
          "$ref": "#/$defs/vault"
        },
        {
          "$ref": "#/$defs/sidecar"
        }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "_id",
        "orgId",
        "kind",
        "name",
        "status",
        "enrollment",
        "credential",
        "health",
        "cachePolicy",
        "createdAt",
        "createdBy",
        "updatedAt",
        "rev"
      ],
      "properties": {
        "orgId": {
          "$ref": "../shared/common.schema.json#/$defs/orgId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "enrollment": {
          "$ref": "../shared/common.schema.json#/$defs/enrollment"
        },
        "credential": {
          "$ref": "../shared/common.schema.json#/$defs/credentialSet",
          "description": "kh_conn_… (vault) / kh_sc_… (sidecar). The component rotates it over its control channel, or an admin rotates it and pastes the new one via stdin."
        },
        "install": {
          "$ref": "../shared/common.schema.json#/$defs/installInfo"
        },
        "health": {
          "$ref": "../shared/common.schema.json#/$defs/componentHealth"
        },
        "cachePolicy": {
          "$ref": "../shared/common.schema.json#/$defs/cachePolicy"
        },
        "createdAt": {
          "$ref": "../shared/common.schema.json#/$defs/isoDate"
        },
        "createdBy": {
          "$ref": "../shared/common.schema.json#/$defs/principalRef"
        },
        "updatedAt": {
          "$ref": "../shared/common.schema.json#/$defs/isoDate"
        },
        "updatedBy": {
          "$ref": "../shared/common.schema.json#/$defs/principalRef"
        },
        "revokedAt": {
          "$ref": "../shared/common.schema.json#/$defs/nullableDate"
        },
        "revokedBy": {
          "anyOf": [
            {
              "$ref": "../shared/common.schema.json#/$defs/principalRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "rev": {
          "$ref": "../shared/common.schema.json#/$defs/rev"
        }
      }
    },
    "vault": {
      "properties": {
        "_id": {
          "$ref": "../shared/common.schema.json#/$defs/vaultConnectorId"
        },
        "kind": {
          "const": "vault"
        },
        "workspaceId": {
          "anyOf": [
            {
              "$ref": "../shared/common.schema.json#/$defs/workspaceId",
              "description": "Workspace it was enrolled to. Informational once it routes an org store."
            },
            {
              "type": "null"
            }
          ]
        },
        "routesStoreIds": {
          "type": "array",
          "items": {
            "$ref": "../shared/common.schema.json#/$defs/storeId"
          },
          "description": "Denormalised from stores.route. Non-empty ⇒ org-level: only org admins rename, rotate, rebind or revoke it.",
          "uniqueItems": true
        },
        "scope": {
          "enum": [
            "org",
            "workspace"
          ],
          "description": "Derived: org when routesStoreIds is non-empty.",
          "readOnly": true
        },
        "egress": {
          "type": "object",
          "description": "Outbound-only tunnel to Keyhole; no inbound ports.",
          "properties": {
            "tunnel": {
              "enum": [
                "wss",
                "grpc"
              ],
              "default": "wss"
            },
            "region": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "_id",
        "kind",
        "routesStoreIds",
        "scope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "routesStoreIds": {
                "minItems": 1
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "const": "org"
              }
            }
          }
        }
      ]
    },
    "sidecar": {
      "properties": {
        "_id": {
          "$ref": "../shared/common.schema.json#/$defs/keyholeSidecarId"
        },
        "kind": {
          "const": "sidecar"
        },
        "workspaceId": {
          "$ref": "../shared/common.schema.json#/$defs/workspaceId"
        },
        "agentId": {
          "$ref": "../shared/common.schema.json#/$defs/agentId",
          "description": "Acts as this agent: its grants, limits, expiry and status apply. Binding to an agent from outside the workspace needs an org admin."
        },
        "local": {
          "$ref": "../shared/common.schema.json#/$defs/localEndpoint"
        },
        "appMode": {
          "enum": [
            "base_url",
            "proxy"
          ],
          "description": "base_url: the app calls http://127.0.0.1:8787/<tool>/…, no CA. proxy: HTTP(S)_PROXY for the tools' hosts; HTTPS needs the sidecar's local CA."
        },
        "proxy": {
          "type": "object",
          "properties": {
            "allowedHosts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Derived from the tools granted to the agent in the workspace; everything else is refused.",
              "readOnly": true
            },
            "localCaFingerprint": {
              "type": "string",
              "description": "SHA-256 of the sidecar's local CA certificate (proxy mode, HTTPS).",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "requestsBase": {
          "type": "integer",
          "description": "Prototype only: traffic before modelled rows.",
          "minimum": 0
        }
      },
      "required": [
        "_id",
        "kind",
        "workspaceId",
        "agentId",
        "local",
        "appMode"
      ]
    }
  },
  "examples": [
