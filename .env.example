# Every environment variable Keyhole reads. Copy to .env and edit; .env is
# git-ignored. Blank means "use the default shown in the comment".

# --- Server -----------------------------------------------------------------
# Address to listen on. Default localhost:8080: loopback only, so a direct
# run is not reachable from the network. Set :8080 (or 0.0.0.0:8080) to
# bind every interface when the network side is handled for you — the
# container image does this, and docker compose publishes that port on
# 127.0.0.1 only. Binding beyond loopback exposes the service to the
# network: put a TLS-terminating reverse proxy in front and use an https
# PUBLIC_URL, so the session cookie gets Secure and the __Host- prefix.
# `keyhole healthcheck` connects to loopback only, so it can't probe a server
# bound to one explicit non-loopback address (use an external GET /healthz).
LISTEN_ADDR=
# The URL people open in the browser: scheme://host[:port], no path
# (Keyhole is served from the root). Must be https unless the host is
# localhost / 127.0.0.1 / ::1. Cookies are Secure whenever this is https.
# Default http://localhost:8080.
PUBLIC_URL=http://localhost:8080
# Log level: debug, info, warn or error. Default info.
LOG_LEVEL=
# Reverse proxies in front of Keyhole, as IP addresses or CIDR networks,
# separated by commas or spaces. Failed sign-ins are rate-limited per client
# address. Default empty: the client is the TCP peer, which is right when
# nothing sits in front of Keyhole. When the peer is a listed proxy,
# X-Forwarded-For is read from the right, skipping listed proxies, and the
# first address that is not one is the client. List only proxies you run
# and that add the address they received the request from; anything that
# can reach a listed proxy directly can set the X-Forwarded-For entries to
# its left. Never list a whole LAN or 0.0.0.0/0.
TRUSTED_PROXIES=

# --- Storage ----------------------------------------------------------------
# Where SQLite keeps its files. Default ./data
# (/data in the container image).
DATA_DIR=
# Database. Postgres:  postgres://user:password@host:5432/keyhole?sslmode=disable
#           SQLite:    sqlite://data/keyhole.db  (relative)  or  sqlite:///var/lib/keyhole/keyhole.db
# Default sqlite://$DATA_DIR/keyhole.db.
DATABASE_URL=

# --- Sign-in ----------------------------------------------------------------
# local, zitadel or both. Default local.
AUTH_MODE=local
# How long a browser session lasts. Default 24h. Minimum 1m.
SESSION_TTL=
# At least 32 characters. Encrypts the short-lived cookie that carries a
# Zitadel sign-in from the redirect to the callback. If unset, a random key
# is used per process (a sign-in in progress fails across a restart).
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Single sign-on, optional: Zitadel or any OpenID Connect provider. Leave
# all OIDC_* blank for local accounts only; Keyhole then never contacts a
# provider. Required when AUTH_MODE is zitadel or both, e.g.
# OIDC_ISSUER=https://idp.example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Always $PUBLIC_URL/auth/oidc/callback; register this exact URL in Zitadel.
# Optional: if set, it must equal that URL or Keyhole refuses to start.
OIDC_REDIRECT_URL=
# Where Zitadel sends the browser after sign-out. Default $PUBLIC_URL/.
# Register it in Zitadel as a post-logout redirect URI.
OIDC_POST_LOGOUT_REDIRECT_URL=
# Space-separated. Default "openid profile email".
OIDC_SCOPES=

# Silent sign-in and single sign-out across the VBCDX suite need nothing
# more here, but the Zitadel app must have these registered:
#   redirect URI             $PUBLIC_URL/auth/oidc/callback
#   post-logout redirect URI $PUBLIC_URL/ (or OIDC_POST_LOGOUT_REDIRECT_URL)
#   back-channel logout URI  $PUBLIC_URL/auth/oidc/backchannel-logout

# One-time first account, for container installs (with docker compose,
# set EMAIL and PASSWORD or there is no account to sign in with). Created only when the
# database has no users at all; ignored afterwards. Remove the password
# once you have signed in. Minimum password length is 12.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- VBCDX suite ---------------------------------------------------------------
# The other VBCDX apps, shown in the app switcher at the top of the sidebar,
# as comma-separated Name=URL pairs. URLs must be https (http only for
# localhost). The entry whose origin is PUBLIC_URL is shown as the current
# app. Unset hides the switcher.
# Example: Dispatch=https://dispatch.example.com,Keyhole=https://keyhole.example.com
SUITE_APPS=

# --- Analytics ---------------------------------------------------------------
# Optional GA4 measurement id (G-XXXXXXXXXX) of your GA4 web data stream.
# Default empty = analytics off: the web app loads no tag and the CSP stays
# strict. The id is public: the web config endpoint serves it to the browser.
GA_MEASUREMENT_ID=

# --- Demo data ----------------------------------------------------------------
# true = at start-up, load the demo organization (Acme Corp: stores, keys,
# tools, workspaces, agents and an audit log) into a database that has no
# organizations yet, and make anyone who signs in without an organization
# an Owner of it, so Keyhole refuses to start unless PUBLIC_URL is loopback.
# The demo data holds no real secrets. `keyhole seed` loads the same data on
# demand. For demos and development only. Default false.
SEED_DEMO_DATA=

# --- The link with vbcdx-control -----------------------------------------------
# Off unless SERVICE_LISTEN_ADDR is set; then all of these but
# CONTROL_SERVER_NAME are required. See docs/resolve.md.
# The forward listener, loopback only: vbcdx-control on this host is the only
# caller (mTLS, its vbcdx:control certificate required). e.g. 127.0.0.1:8444
SERVICE_LISTEN_ADDR=
# The enrolled certificate (`vbcdx-control services add keyhole --cert-out`)
# and its key (`keyhole service csr --key-out`, 0600).
SERVICE_CERT_FILE=
SERVICE_KEY_FILE=
# The control CA certificate (PEM) that signs control's certificates.
CONTROL_CA_FILE=
# vbcdx-control's tunnel listener, for the signing keys, by the name its tunnel
# certificate carries (e.g. https://127.0.0.1:8443 when that name is 127.0.0.1).
CONTROL_URL=
# The name control's server certificate carries, when it isn't CONTROL_URL's host.
CONTROL_SERVER_NAME=
# The KEK file from `keyhole kek generate`: resolve opens Local values with it.
KEK_FILE=

# --- docker-compose.yml only -------------------------------------------------
# Password for the bundled Postgres. Use URL-safe characters (it is placed
# in DATABASE_URL). Required by docker compose.
POSTGRES_PASSWORD=
# Host port for Keyhole, published on 127.0.0.1 only. Default 8080.
KEYHOLE_PORT=

# --- Development and tests only ----------------------------------------------
# `npm run dev` in web/ proxies to this Keyhole server. Default http://localhost:8080.
KEYHOLE_DEV_BACKEND=
# Run the Go tests against Postgres too (each test gets its own schema).
KEYHOLE_TEST_POSTGRES_URL=
# 1 = fail instead of skipping when KEYHOLE_TEST_POSTGRES_URL is unset (CI sets this).
KEYHOLE_TEST_REQUIRE_POSTGRES=
