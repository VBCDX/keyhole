# Keyhole on a plain Linux host or LXC, installed by hand. The
# installer's own unit is `vbcdx install service keyhole-server`.
# Install: a system user `keyhole` (no shell, no login), the binary at
# /usr/local/lib/keyhole/keyhole, /etc/keyhole/keyhole.env (0640 root:keyhole)
# and the KEK at /etc/keyhole/kek (0600 keyhole:keyhole). Check the result
# with `systemd-analyze security keyhole.service`.
[Unit]
Description=Keyhole secrets broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keyhole
Group=keyhole
EnvironmentFile=/etc/keyhole/keyhole.env
Environment=DATA_DIR=/var/lib/keyhole
ExecStart=/usr/local/lib/keyhole/keyhole serve
Restart=on-failure
RestartSec=5s

StateDirectory=keyhole
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Rule 4 at the unit level: loopback only, in and out. Keyhole never calls
# a consuming service; its only peers are vbcdx-control and the
# healthcheck on this host. This needs cgroup BPF, so it is a no-op in an
# unprivileged LXC: there an nft rule for the keyhole uid is the control,
# and these lines are defence for a host or VM install.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
